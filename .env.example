# =============================================================================
# VARIABLES DE ENTORNO — SISTEMA DE TAREAS (PLANEAMIENTO)
# Plantilla de ejemplo. Copiar a .env y configurar con credenciales reales.
# =============================================================================

# Entorno de ejecución: 'development' | 'production'
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Base de Datos MySQL / MariaDB (DonWeb Ferozo)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=planeamiento_tareas
DB_USER=root
DB_PASS=

# Seguridad y Sesiones
# Generar clave secreta de 64 caracteres para firma de tokens o HMAC
APP_SECRET=cambiar_esta_clave_secreta_por_un_hash_aleatorio_de_64_caracteres_minimo
SESSION_LIFETIME_HOURS=12

# Almacenamiento de Adjuntos (directorio local relativo o absoluto fuera de public_html)
UPLOAD_DIR=../storage/uploads
MAX_UPLOAD_SIZE_MB=10
